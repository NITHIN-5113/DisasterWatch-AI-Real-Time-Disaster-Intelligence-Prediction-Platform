{
  "name": "disasterwatch-fullstack",
  "version": "1.0.0",
  "description": "DisasterWatch — Real-Time Geospatial Operations & Disaster Monitoring Command Center",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node node_modules/npm-run-all/bin/npm-run-all/index.js --parallel backend:dev frontend:dev",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "frontend:build": "cd frontend && npm run build",
    "build": "node node_modules/npm-run-all/bin/npm-run-all/index.js --parallel backend:build frontend:build",
    "frontend:start": "cd frontend && npm run start",
    "start": "node node_modules/npm-run-all/bin/npm-run-all/index.js --parallel backend:dev frontend:start",
    "test": "npm run test --workspace=backend && npm run lint:emoji",
    "backend:test": "npm run test --workspace=backend",
    "frontend:test": "echo \"Frontend tests OK\"",
    "lint:emoji": "node scripts/check-emojis.js",
    "db:migrate": "cd backend && npm run db:migrate",
    "db:push": "cd backend && npm run db:push",
    "db:generate": "cd backend && npm run db:generate",
    "db:seed": "cd backend && npm run db:seed",
    "db:studio": "cd backend && npm run db:studio"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
